{
  "name": "worknest-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:undo": "node scripts/migrate.js down",
    "db:seed": "node src/database/seed-demo.js",
    "db:seed:demo": "node src/database/seed-demo.js",
    "db:seed:test-data": "node scripts/test-data/import-kaggle.js",
    "db:seed:continuity-data": "node scripts/historical-data/import-historical-hr.js",
    "db:verify": "node scripts/verify-database.js",
    "db:verify:performance": "node scripts/verify-performance-isolation.js",
    "db:verify:safety": "node scripts/verify-database-safety.js",
    "db:verify:payroll": "node scripts/verify-payroll-integrity.js",
    "db:fresh": "node scripts/migrate.js fresh",
    "db:rollback:test": "node scripts/rollback-test.js",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore.ps1",
    "qa": "powershell -ExecutionPolicy Bypass -File scripts/phase13-qa.ps1",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "mysql2": "3.23.2",
    "nodemailer": "7.0.6",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "pdfkit": "0.17.2",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "sequelize": "6.37.8",
    "express-rate-limit": "8.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "sequelize-cli": "6.6.3"
  }
}
