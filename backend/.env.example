NODE_ENV=development
PORT=5000
HOST=127.0.0.1
API_PREFIX=/api/v1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=worknest
DB_USER=root
DB_PASSWORD=
DB_LOG_SQL=false
DB_POOL_MAX=10
DB_POOL_MIN=0

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=worknest_refresh
RESET_TOKEN_EXPIRES_MINUTES=30
INVITE_TOKEN_EXPIRES_HOURS=72
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
APP_VERSION=0.1.0

# Optional infrastructure
REDIS_URL=
EMAIL_ENABLED=false
EMAIL_FROM=WorkNest <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=./uploads/documents
FILE_MAX_BYTES=5242880
